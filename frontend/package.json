{
  "name": "helascribe",
  "version": "1.0.0",
  "main": "index.ts",
  "scripts": {
    "start": "expo start --go --lan",
    "usb:reverse": "adb reverse tcp:8081 tcp:8081 && adb reverse tcp:8000 tcp:8000",
    "start:usb": "npm run usb:reverse && set EXPO_PUBLIC_API_URL=http://127.0.0.1:8000/api&& expo start --go --localhost",
    "start:tunnel": "expo start --go --tunnel",
    "android": "expo start --go --lan --android",
    "start:dev-client": "set HELASCRIBE_LIVEKIT_NATIVE=1&& expo start --dev-client --lan",
    "android:native": "set HELASCRIBE_LIVEKIT_NATIVE=1&& expo run:android",
    "android:build": "set HELASCRIBE_LIVEKIT_NATIVE=1&& cd android && gradlew.bat assembleDebug",
    "ios": "expo run:ios",
    "web": "expo start --web",
    "typecheck": "tsc --noEmit",
    "build:web": "expo export --platform web"
  },
  "dependencies": {
    "@expo-google-fonts/dm-sans": "^0.4.2",
    "@expo/metro-runtime": "~57.0.8",
    "@expo/vector-icons": "^15.0.3",
    "@livekit/react-native": "^2.12.0",
    "@livekit/react-native-webrtc": "^144.1.2",
    "expo": "~57.0.23",
    "expo-asset": "~57.0.9",
    "expo-audio": "~57.0.2",
    "expo-clipboard": "~57.0.1",
    "expo-dev-client": "^57.0.10",
    "expo-document-picker": "~57.0.1",
    "expo-file-system": "~57.0.2",
    "expo-font": "~57.0.1",
    "expo-linear-gradient": "~57.0.1",
    "expo-sharing": "~57.0.11",
    "expo-speech": "^57.0.3",
    "expo-status-bar": "~57.0.1",
    "livekit-client": "^2.21.0",
    "react": "19.2.3",
    "react-dom": "19.2.3",
    "react-native": "0.86.2",
    "react-native-safe-area-context": "~5.7.0",
    "react-native-web": "~0.21.0"
  },
  "devDependencies": {
    "@types/react": "~19.2.2",
    "typescript": "~6.0.3"
  },
  "private": true
}
