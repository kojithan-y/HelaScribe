# FastAPI server
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=true
APP_NAME=HelaScribe API
API_PREFIX=/api
ALLOWED_ORIGINS=*

# Existing Google Cloud Vertex AI service-account JSON
VERTEX_SERVICE_ACCOUNT_JSON=./service-account.json
GCP_PROJECT=
GCP_LOCATION=global

# Gemini model IDs
GEMINI_LIVE_MODEL=gemini-3.5-flash
GEMINI_BATCH_MODEL=gemini-3.5-flash
LIVE_CHUNK_SECONDS=8.0
LIVE_CHUNK_OVERLAP_SECONDS=1.0
LIVE_SILENCE_RMS_THRESHOLD=200
LIVE_FINALIZE_FULL_AUDIO=true
MAX_LIVE_MINUTES=120
MAX_UPLOAD_MB=20

# Hugging Face / pyannote
HUGGINGFACE_TOKEN=hf_replace_me
PYANNOTE_MODEL=pyannote/speaker-diarization-community-1

# Local persistence
DATA_DIR=./data
